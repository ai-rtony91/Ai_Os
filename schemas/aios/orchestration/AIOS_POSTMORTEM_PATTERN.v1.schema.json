{
  "$id": "https://aios.local/schemas/AIOS_POSTMORTEM_PATTERN.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "const": "OPERATIONAL_EVIDENCE_ONLY"
    },
    "duplicate_suppressed": {
      "type": "boolean"
    },
    "human_owner_review_required": {
      "type": "boolean"
    },
    "incident_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "independent_incident_count": {
      "minimum": 0,
      "type": "integer"
    },
    "promotion_eligible": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0"
    },
    "signature": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "signature",
    "incident_ids",
    "independent_incident_count",
    "duplicate_suppressed",
    "promotion_eligible",
    "human_owner_review_required",
    "authority"
  ],
  "description": "Independent-incident recurrence evidence with fail-closed promotion metadata.",
  "title": "AIOS Post-Mortem Pattern v1",
  "type": "object"
}
